# Environment template — copy to .env and fill values (never commit .env)
ENV=development

# Supabase (required for real DB)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (workers / signed URLs / migrations) — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional server alias; workers fall back to NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Enable persistent Postgres polling in deployed worker processes
WORKER_OCR_POLL=1
WORKER_NOTIFY_POLL=1

# Apply SQL migrations (pick ONE):
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# or
SUPABASE_DB_PASSWORD=your-database-password
# Optional overrides if pooler host differs:
# SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_USER=postgres.YOUR_REF
