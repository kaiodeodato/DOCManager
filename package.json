{
  "name": "doc-manager",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx turbo run build",
    "build:web": "npm run build -w lucide-react && npm run build -w @ac/shared && npm run build -w @ac/ui && npm run build -w @ac/web",
    "build:worker-ocr": "npm run build -w @ac/shared && npm run build -w @ac/worker-ocr",
    "build:worker-notify": "npm run build -w @ac/shared && npm run build -w @ac/worker-notify",
    "dev": "npx turbo run dev",
    "lint": "npx turbo run lint",
    "test": "npx turbo run test",
    "typecheck": "npx turbo run typecheck",
    "format": "prettier --write .",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "turbo": "2.10.8",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "supportedArchitectures": {
    "os": [
      "current",
      "win32",
      "linux",
      "darwin"
    ],
    "cpu": [
      "current",
      "x64",
      "arm64"
    ]
  },
  "overrides": {
    "jspdf": "4.2.1",
    "sharp": "0.35.3",
    "postcss": "8.5.25",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
