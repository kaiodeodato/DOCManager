{
  "name": "doc-manager",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx turbo run build",
    "dev": "npx turbo run dev",
    "lint": "npx turbo run lint",
    "test": "npx turbo run test",
    "typecheck": "npx turbo run typecheck",
    "format": "prettier --write .",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "jspdf": "4.2.1",
    "sharp": "0.35.3",
    "postcss": "8.5.25",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
